# This app's own origin, and the reader's. The two must be the same site (such as two
# subdomains of one domain), so the reader's requests carry this app's cookies.
PLUG_ORIGIN=http://localhost:5304
READER_ORIGIN=http://localhost:5302

# Seals the credentials kept in cookies: 32 random bytes, base64. Generate one with
#   openssl rand -base64 32
# Changing it disconnects everyone.
PLUG_SECRET=

# The 得到大脑 open-platform application, used only to start an authorization.
GETNOTE_CLIENT_ID=
GETNOTE_APP_KEY=

# PORT=3304
# HOST=127.0.0.1
