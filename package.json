{
  "name": "gamma-reader-plug-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gamma-reader-plug/web --filter @gamma-reader-plug/server dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "biome check . && pnpm typecheck && pnpm test",
    "build": "pnpm -r build",
    "start": "pnpm --filter @gamma-reader-plug/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3"
  }
}
